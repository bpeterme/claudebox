# claudebox user configuration
# Copy to ~/.config/claudebox/cbox.env and uncomment/customize the values you need.
# If $XDG_CONFIG_HOME is set, use $XDG_CONFIG_HOME/claudebox/cbox.env instead.
# This file is sourced as a shell script, so variable expansion works.
#
# All settings are optional — cbox works without this file using the defaults shown below.

# ─── agent ────────────────────────────────────────────────────────────────────

# Default AI coding agent to run in the container (default: claude).
# Supported values: claude, opencode
# Can also be overridden per-invocation with: cbox oc [...]
# CBOX_AGENT=claude

# ─── output ───────────────────────────────────────────────────────────────────

# Show full output: npm updates, sync messages, MCP relay status (default: 0)
# Can also be set per-invocation with: cbox -v
# CBOX_VERBOSE=0

# ─── image & container ────────────────────────────────────────────────────────

# CBOX_IMAGE="claudebox"            # Docker image name (default: claudebox)
# CBOX_LABEL="cbox.project=true"   # Label applied to all cbox containers
# CBOX_KEEPALIVE_SECONDS=600       # Seconds before auto-stop in keepalive mode

# ─── host paths ───────────────────────────────────────────────────────────────

# Per-project container config files (.claude-<name>.json), one per project
# Defaults to $XDG_DATA_HOME/claudebox (~/.local/share/claudebox if XDG_DATA_HOME is unset)
# CBOX_DATA_DIR="$HOME/.local/share/claudebox"

# Claude Code config directory — mounted into the container as ~/.claude
# CBOX_CLAUDE_DIR="$HOME/.claude"

# Host config dir to mount into the container as ~/.config (normal mode only)
# Defaults to $XDG_CONFIG_HOME (~/.config if XDG_CONFIG_HOME is unset)
# CBOX_HOST_CONFIG_DIR="$HOME/.config"

# Share directory — mounted as ~/share inside the container; cleared on exit
# Defaults to ~/.cache/claudebox/share (respects $XDG_CACHE_HOME if set)
# CBOX_SHARE_DIR="$HOME/.cache/claudebox/share"

# Playwright browser cache — mounted over /opt/ms-playwright in the container,
# so Chromium is downloaded once per machine instead of once per container.
# Shared by every project and kept across resets, prunes and image rebuilds.
# Nothing prunes it: each playwright upgrade leaves its old Chromium behind, so
# it grows over time. `cbox doctor` reports its size; clear it with rm -rf.
# Defaults to $CBOX_DATA_DIR/ms-playwright
# CBOX_PLAYWRIGHT_DIR="$HOME/.local/share/claudebox/ms-playwright"

# MCP servers that run on the host and are relayed into the container
# (e.g. iMCP). Same format as Claude's mcpServers; see README "Host MCP Servers".
# Defaults to $XDG_CONFIG_HOME/claudebox/mcp.json (~/.config/... if unset)
# CBOX_MCP_CONFIG="$HOME/.config/claudebox/mcp.json"

# warden: host-side credential broker. Resource definitions, approvals and
# session tokens live here — host only, never mounted into a container.
# Defaults to $CBOX_DATA_DIR/warden
# CBOX_WARDEN_DIR="$HOME/.local/share/claudebox/warden"
# Port the broker listens on, bound only to the address containers reach the
# host on (Apple container: 192.168.64.1) — not on the local network.
# CBOX_WARDEN_PORT=47100

# Memory of each container (default 4g; Apple's runtime would otherwise give 1 GB).
# Takes effect for newly created containers: cbox reset
# CBOX_MEMORY=4g

# Mount the project's .git/config and .git/hooks read-only, so code in the
# container cannot plant commands git would run on the Mac (default 1).
# 0 = writable. Takes effect for newly created containers: cbox reset
# CBOX_PROTECT_GIT=1
# Override that address if your container network differs.
# CBOX_WARDEN_HOST=192.168.64.1
# Hosts without the macOS Keychain: a command that prints the secret for an
# item name, e.g. a wrapper around `pass` or `secret-tool`.
# CBOX_WARDEN_SECRET_CMD="$HOME/bin/warden-secret"

# ─── optional mounts (leave unset to disable) ─────────────────────────────────

# SSH directory to mount as ~/.ssh inside the container (normal mode only)
# CBOX_SSH_DIR="$HOME/.ssh"

# Path to a .zshrc to source inside the container as ~/.zshrc.global
# CBOX_ZSHRC="$HOME/.zshrc"

# ─── build ────────────────────────────────────────────────────────────────────

# Directory containing the dockerfile (default: directory of cbox.sh)
# CBOX_BUILD_DIR="$HOME/path/to/claudebox"

# Set to 1 to include Playwright + Chromium in the image (~1.3 GB extra).
# Takes effect on the next `cbox rebuild`; it can also be passed inline, as in
# `BUILD_PLAYWRIGHT=1 cbox rebuild`. Either way CBOX_PLAYWRIGHT_DIR is seeded
# from whatever the image turns out to contain, so this setting only decides
# whether the download happens at build time or on first use.
# BUILD_PLAYWRIGHT=0

# ─── voice mode ───────────────────────────────────────────────────────────────

# Enable Claude Code voice mode (/voice) inside the container.
# Requires PulseAudio on the host: brew install pulseaudio
# PulseAudio starts and stops automatically with each cbox session.
# Requires a Claude.ai account (not compatible with raw API key auth).
# CBOX_AUDIO=1

# ─── companion tools ──────────────────────────────────────────────────────────

# claudedot — cross-machine config + history sync via git
# Install: brew tap bpeterme/claudedot && brew install bpeterme/claudedot/claudedot
# Set up:  cdot config

# flux — large-file routing for your projects (git + R2 storage)
# Install: brew tap bpeterme/flux && brew install bpeterme/flux/flux
# Set up:  flux setup
